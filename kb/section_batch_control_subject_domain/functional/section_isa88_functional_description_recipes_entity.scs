section_isa88_functional_description_recipes_entity
<- sc_node_structure;
=> nrel_main_idtf:
	[Раздел. Предметная область функционального описания объекта рецептов]
	(* <- lang_ru;; *);
	[Section. Subject domain of ​​functional description recipies entitiy]
	(* <- lang_en;; *);
	[Розділ. Предметна область функціонального опису об'єкта рецептів]
	(* <- lang_uk;; *);
	[Kapitel. Themengebiet der Funktionsbeschreibung des Rezeptobjekts]
	(* <- lang_de;; *);
-> rrel_maximum_studied_object_class:
recipe_entity;
=> nrel_inclusion:
general_recipe_entity;
site_recipe_entity;
master_recipe_entity;
control_recipe_entity;;

general_recipe_entity
<- sc_node_class;
=> nrel_main_idtf:
	[общий объект рецепта]
	(* <- lang_ru;; *);
	[general recipe entity]
	(* <- lang_en;; *);
	[загальний об'єкт рецепта]
	(* <- lang_uk;; *);
=> nrel_summary:
	[Вся информация по общему рецепту или рецепту сайта, компонент общего рецепта или рецепта сайта или блок для создания общего рецепта или рецепта сайта.]
	(* <- lang_ru;; *);
	[All of a general or site recipe, a component of a general or site recipe, or a building block for creation of a general or site recipe.]
	(* <- lang_en;; *);
	[Вся інформація за загальним рецептом або рецептом сайту, компонент загального рецепту або рецепту сайту або блок для створення загального рецепту або рецепту сайту.]
	(* <- lang_uk;; *);
=> nrel_inclusion:
scale_reference;;

