section_isa88_functional_description_recipes_requirement
<- sc_node_structure;
=> nrel_main_idtf:
	[Раздел. Предметная область функционального описания оборудования рецептов]
	(* <- lang_ru;; *);
	[Section. Subject domain of ​​functional description recipes requirement]
	(* <- lang_en;; *);
	[Розділ. Предметна область функціонального опису обладнання рецептів]
	(* <- lang_uk;; *);
	[Kapitel. Themengebiet der Funktionsbeschreibung von Rezepturgeräten]
	(* <- lang_de;; *);
-> rrel_maximum_studied_object_class:
selection_of_equipment;
=> nrel_inclusion:
equipment_requirement;
equipment_procedural_element;
equipment_entity;
equipment_property;
equipment_property_type;
equipment_relation;
equipment_class;;

equipment_requirement
<- sc_node_class;
=> nrel_main_idtf:
	[требования к оборудованию]
	(* <- lang_ru;; *);
	[equipment requirement]
	(* <- lang_en;; *);
	[вимоги до обладнання]
	(* <- lang_uk;; *);
=> nrel_summary:
	[Представляет требование к оборудованию, указанное в объекте рецепта.]
	(* <- lang_ru;; *);
	[Represents an equipment requirement as specified in the recipe entity.]
	(* <- lang_en;; *);
	[Подає вимогу до обладнання, зазначену в об'єкті рецепту.]
	(* <- lang_uk;; *);;

equipment_procedural_element
<- sc_node_class;
=> nrel_summary:
	[Процедурный элемент, связанный с частью оборудования.]
	(* <- lang_ru;; *);
	[A procedural element that is associated with a piece of equipment.]
	(* <- lang_en;; *);
	[Процедурний елемент, пов'язаний із частиною обладнання.]
	(* <- lang_uk;; *);
=> nrel_inclusion:
equipment_procedural_element_id;
recipe_version;
version_date;
approval_date;
recipe_author;
recipe_approval;
version_description;
level_class_equivalence;
mode;
state;;

